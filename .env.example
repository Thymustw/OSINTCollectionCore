# 複製成 .env 後再改。不要把真實密碼寫進版本庫。
# 本檔只放 placeholder；應用程式應透過 SecretRef（env: / file: / store:）取值。
#
# ===========================================================================
# ⚠️ 這整份檔案是給**宿主上的 `cargo run`** 用的，不是給容器用的
# ===========================================================================
# 容器版（`make compose-up-full`）的設定寫在 docker/docker-compose.yml 的
# `x-osint-env`，**不要**對應用服務用 `env_file: ../.env` 把這份灌進去。
#
# 差在哪（每一行下面都有標註「容器內」）：
#
#   後端        本機（這份）              容器內
#   ---------   -----------------------   -------------------------
#   PostgreSQL  127.0.0.1:5432            postgres:5432
#   OpenSearch  127.0.0.1:19200           opensearch:9200
#   MinIO       127.0.0.1:19000           minio:9000
#   Redis       127.0.0.1:6379            redis:6379
#   Redpanda    127.0.0.1:9092            redpanda:29092   ← 埠也不同
#   Neo4j       127.0.0.1:7474/7687       neo4j:7474/7687
#   埠隔離開關  OSINT_STRICT_PORT_ISOLATION=1   不設
#   bind        127.0.0.1:1808x           0.0.0.0:1808x
#
# 完整說明與踩雷紀錄見 docs/developer/local-dev.md、docs/operations/OPERATIONS.md §15。

# --- PostgreSQL（canonical store）---
POSTGRES_USER=osint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osint_core
# core-config 預設讀這個環境變數名稱（SecretRef env:DATABASE_URL）
# 容器內：postgres://osint:...@postgres:5432/osint_core
DATABASE_URL=postgres://osint:change-me@127.0.0.1:5432/osint_core

# --- SQLite（embedded / App / 本機投影，不是 Core canonical）---
SQLITE_PATH=./var/osint-local.sqlite

# --- 本機埠隔離（只有「這台機器同時跑著另一套 OpenCTI」時才需要）---
# 開啟後 storage-opensearch / storage-s3 的 conformance test 會拒絕連到 9200/9000
# （這台機器上那是 OpenCTI 的 Elasticsearch/MinIO，不是我們自己的服務）。
# CI 或其他沒有這個埠衝突的機器，不要設這個變數——那些環境的 9200/9000
# 就是本專案自己乾淨的服務，不該被擋（GitHub Actions 的第一次 CI run 就因為
# 誤設這個規則為全域預設值而失敗過，見 git history）。
#
# 容器內：**絕對不要設**。compose network 的 opensearch:9200 / minio:9000
# 是本專案自己的服務，設了會被 verify_not_opencti_search 擋下來，而且錯誤
# 訊息會叫你改成 19200——那在容器內是錯的建議。
OSINT_STRICT_PORT_ISOLATION=1

# --- OpenSearch ---
# docker-compose.yml 預設掛 9200。本工作站 9200 是 OpenCTI Elasticsearch，
# 不是 osint-core。dev overlay 掛 19200；本機測試／程式要用 19200
# （因為上面開了 OSINT_STRICT_PORT_ISOLATION）。
# 容器內：http://opensearch:9200
OPENSEARCH_URL=http://127.0.0.1:19200
# 覆蓋 config/default.toml 的 canonical 9200
OSINT__STORAGE__SEARCH__URL=http://127.0.0.1:19200

# --- Redpanda ---
# 容器內：redpanda:29092（**埠不一樣**）。9092 那個 listener 宣告的位址是
# 127.0.0.1，容器連上去等於連自己，症狀是 AllBrokersDown/MessageTimedOut，
# 但健康檢查全綠——表現成「匯入回 201 但搜尋不到」。見 local-dev.md。
REDPANDA_BROKERS=127.0.0.1:9092

# --- Redis ---
# 容器內：redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# --- MinIO / S3 ---
# 本工作站 9000 是 OpenCTI MinIO。dev overlay 掛 19000 / 19001。
# conformance 會拒絕非 19000 的 endpoint。
# 容器內：http://minio:9000
S3_ENDPOINT=http://127.0.0.1:19000
S3_BUCKET=raw-evidence
MINIO_ROOT_USER=osint
MINIO_ROOT_PASSWORD=change-me-minio
OSINT__STORAGE__OBJECT__ENDPOINT=http://127.0.0.1:19000

# --- Neo4j（V0.2 圖投影）---
# 容器內：bolt://neo4j:7687 / http://neo4j:7474
#
# ⚠️ Community 版的**初始使用者只能是 `neo4j`**。NEO4J_USER 設成別的名字，
# 容器不會報錯，也不會建立那個帳號——只會在登入時變成「密碼錯誤」。
# 要別的帳號得先用 neo4j 登入再以 Cypher 建立。
# ⚠️ 密碼至少 8 個字元，太短容器會啟動失敗。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
# /api/v1/ops/health 的探活位址（HTTP，7474）。V0.2 Phase 0b 只用這個；
# 上面的 NEO4J_URI/USER/PASSWORD 要等 Phase 2a 的 storage-neo4j adapter 才會被讀。
OSINT__STORAGE__GRAPH__HTTP_URL=http://127.0.0.1:7474

# --- JWT（API skeleton；至少 32 bytes）---
JWT_SECRET=change-me-to-a-random-32-byte-minimum-secret

# --- HTTP ---
# 本工作站 8080 是 OpenCTI；osint-api 用 18080。
# 容器內：0.0.0.0:18080。預設的 127.0.0.1 在容器裡等於「只有容器自己連得到」，
# HEALTHCHECK 還是會過，但宿主與其他容器都打不到。
# 各 worker 同理：OSINT__COLLECTOR__BIND … OSINT__INDEXER__BIND = 0.0.0.0:1808x
OSINT__HTTP__BIND=127.0.0.1:18080

# --- 應用設定（覆蓋 config/default.toml；巢狀鍵用 __）---
OSINT__APP__ENVIRONMENT=dev
# 留空等於未設定。空字串不會當成必填 TOML 路徑。
OSINT_CONFIG_FILE=
