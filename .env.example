# 複製成 .env 後再改。不要把真實密碼寫進版本庫。
# 本檔只放 placeholder；應用程式應透過 SecretRef（env: / file: / store:）取值。

# --- PostgreSQL（canonical store）---
POSTGRES_USER=osint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=osint_core
# core-config 預設讀這個環境變數名稱（SecretRef env:DATABASE_URL）
DATABASE_URL=postgres://osint:change-me@127.0.0.1:5432/osint_core

# --- SQLite（embedded / App / 本機投影，不是 Core canonical）---
SQLITE_PATH=./var/osint-local.sqlite

# --- OpenSearch ---
# docker-compose.yml 預設掛 9200。若主機 9200 已被其他堆疊佔用，
# docker-compose.dev.yml 會改掛 19200，請把下面改成 http://127.0.0.1:19200
OPENSEARCH_URL=http://127.0.0.1:9200

# --- Redpanda ---
REDPANDA_BROKERS=127.0.0.1:9092

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- MinIO / S3 ---
# 同上，dev override 在埠號衝突時改掛 19000 / 19001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=raw-evidence
MINIO_ROOT_USER=osint
MINIO_ROOT_PASSWORD=change-me-minio

# --- 應用設定（覆蓋 config/default.toml；巢狀鍵用 __）---
OSINT__APP__ENVIRONMENT=dev
OSINT_CONFIG_FILE=
